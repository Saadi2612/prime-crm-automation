# Copy to .env and fill in. Never commit .env — it holds a password and a TOTP seed.

# ── Target ───────────────────────────────────────────────────────────
# Tenant workspace URL. The subdomain IS the tenant: the harness never
# touches another tenant's host, and the session store is keyed by it.
CRM_BASE_URL=http://acme.localhost:3000
CRM_TENANT=acme

# ── Credentials ──────────────────────────────────────────────────────
CRM_EMAIL=automation@acme.test
CRM_PASSWORD=
# Base32 TOTP seed shown during enrollment (the "manual entry key").
# Codes are generated from this at run time; the seed itself is never logged.
CRM_TOTP_SECRET=

# ── Run behaviour ────────────────────────────────────────────────────
# Fields scoring below this are sent to the human review queue instead of
# being written to the CRM.
CONFIDENCE_THRESHOLD=0.8
HEADLESS=true
# Per-step navigation/assertion timeout, milliseconds.
STEP_TIMEOUT_MS=15000
# Attempts for retry-safe steps only. The write step is never blind-retried.
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500

# ── Storage ──────────────────────────────────────────────────────────
STATE_DIR=./state
ARTIFACT_DIR=./artifacts
LOG_LEVEL=info
